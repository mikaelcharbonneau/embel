# Copy to .embel-dev/strategy.env, naming.env or logo.env as appropriate.
# The public loopback settings come from .embel-dev/web.env.
# Supply a real, separately provisioned restricted local database role and owner.
EMBEL_DEVELOPMENT_WORKER_DATABASE_URL=
EMBEL_DEVELOPMENT_WORKER_OWNER_ID=
EMBEL_DEVELOPMENT_WORKER_DEPLOYMENT_ID=

# Application provider credentials belong here, never in browser variables.
EMBEL_DEVELOPMENT_PROVIDER_API_KEY=
EMBEL_DEVELOPMENT_MODEL=
EMBEL_DEVELOPMENT_VERIFIED_MODELS=
EMBEL_DEVELOPMENT_DISPATCH_APPROVED=false
FLUID_PAID_CALLS_APPROVED=false

# Logo's additional operation and Storage bindings:
EMBEL_DEVELOPMENT_LOGO_WORKER_ID=
EMBEL_DEVELOPMENT_LOGO_STORAGE_USER_ID=
EMBEL_DEVELOPMENT_LOGO_STORAGE_ACCESS_TOKEN=
EMBEL_DEVELOPMENT_LOGO_OPERATIONS=
EMBEL_DEVELOPMENT_IMAGE_RATE_VERSION=

#!/bin/sh
# BusyBox wget ignores NO_PROXY. Only these local container health probes opt out.
health_url=
if [ "$#" -eq 3 ] && [ "$1" = '-q' ] && [ "$2" = '--spider' ]; then
  health_url=$3
elif [ "$#" -eq 4 ] && [ "$1" = '--no-verbose' ] && [ "$2" = '--tries=1' ] && [ "$3" = '--spider' ]; then
  health_url=$4
fi
case "$health_url" in
  http://127.0.0.1:9999/health|http://127.0.0.1:5000/status)
    exec /usr/bin/wget -Y off -q --spider "$health_url"
    ;;
esac
exec /usr/bin/wget "$@"

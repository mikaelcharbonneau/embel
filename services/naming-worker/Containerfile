# Runtime-only image: Vercel builds from the isolated release directory.
# Do not declare build ARGs or copy the checkout into this image.
FROM node:22.22.2-bookworm-slim
WORKDIR /opt/embel/naming
ENV NODE_ENV=production
COPY --chown=node:node dist/index.js dist/package.json dist/build-manifest.json ./dist/
USER node
CMD ["node", "dist/index.js"]

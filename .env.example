# Optional public configuration for the development web process.
# Leave empty for browser-only work with unavailable account integrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3105

# Cloud development setup does not authorize paid inference.
FLUID_PAID_CALLS_APPROVED=false
NEXT_TELEMETRY_DISABLED=1

# Configure worker/database/provider credentials separately after explicit approval.
# Never put privileged credentials in NEXT_PUBLIC_* variables or commit them.

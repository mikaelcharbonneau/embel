# Optional manual public configuration for the development web process.
# npm run dev:up manages its own public settings in .embel-dev/web.env.
# Leave empty for browser-only work with unavailable account integrations.
# The full list of variables is in docs/environment-variables.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3105
NEXT_TELEMETRY_DISABLED=1

# Never put privileged credentials in NEXT_PUBLIC_* variables or commit them.

# Optional manual public configuration for the development web process.
# npm run dev:up manages its own public settings in .embel-dev/web.env.
# Leave empty for browser-only work with unavailable account integrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3105

# Development starts without dispatch; lane execution settings enable generation.
FLUID_PAID_CALLS_APPROVED=false
NEXT_TELEMETRY_DISABLED=1

# Optional local web connection to the existing protected research worker.
# Enable only after its exact development identity and deployment are qualified.
# See docs/local-research-preview.md. No provider or database secret belongs here.
# FLUID_LOCAL_API_TEXT_ENABLED=true
# VERCEL_PROJECT_ID=prj_WKrFUPy3wptZ3qI9l1hTuqPmzkDt
# FLUID_API_TEXT_WORKER_ORIGIN=https://qualified-worker-deployment.vercel.app

# Optional production web routing to the account-bound logo image worker.
# Requires the exact canonical Vercel web project and separately activated worker.
# Worker provider, database and Storage credentials never belong in the web env.
# FLUID_HOSTED_LOGO_ENABLED=true

# Configure worker/database/provider credentials in the separate lane environment.
# Never put privileged credentials in NEXT_PUBLIC_* variables or commit them.

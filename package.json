{
  "name": "embel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3105",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3105",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "worker": "node --conditions=react-server --import tsx worker/index.ts",
    "worker:naming": "node scripts/naming-worker.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:api-text-worker": "node scripts/build-api-text-worker.mjs",
    "build:naming-worker": "node scripts/build-naming-worker.mjs",
    "package:naming-worker": "node scripts/package-naming-worker.mjs",
    "build:logo-worker": "node scripts/build-logo-worker.mjs",
    "package:logo-worker": "node scripts/package-logo-worker.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/functions": "3.10.1",
    "@vercel/oidc": "4.0.0",
    "@vercel/queue": "0.8.0",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "geist": "1.7.2",
    "harfbuzzjs": "1.6.2",
    "jose": "6.2.12",
    "next": "16.3.8",
    "openai": "7.35.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "svg-pathdata": "7.2.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

{
  "name": "embel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "node scripts/development-web.mjs",
    "dev:setup": "node scripts/development.mjs setup",
    "dev:up": "node scripts/development.mjs up",
    "dev:down": "node scripts/development.mjs down",
    "dev:doctor": "node scripts/development.mjs doctor",
    "test:setup": "node --test tests/setup/*.test.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3105",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,css}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:journey": "playwright test -c playwright.journey.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev:secrets": "node scripts/development/secrets.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/functions": "3.10.1",
    "botid": "1.5.12",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "geist": "1.7.2",
    "harfbuzzjs": "1.6.2",
    "next": "16.4.4",
    "openai": "7.35.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.1",
    "svg-pathdata": "7.2.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "undici@7": "7.30.2",
    "zod@4.1": "4.6.7",
    "zod@4.5": "4.6.7",
    "minimatch@9": "11.0.4",
    "minimatch@10": "11.0.4"
  }
}
